package web

import (
	"fmt"
	"strings"
)

templ icon(name string, class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "memory":
				<path d="M12 3a4 4 0 0 0-4 4v.2A4 4 0 0 0 5 11a4 4 0 0 0 1 7.7A4 4 0 0 0 12 21m0-18a4 4 0 0 1 4 4v.2a4 4 0 0 1 3 3.8 4 4 0 0 1-1 7.7A4 4 0 0 1 12 21M8 9h4m0-3v15m0-8h4m-8 5h4"/>
			case "models":
				<rect x="4" y="4" width="16" height="16" rx="4"/><path d="M9 9h6v6H9zM9 1v3m6-3v3M9 20v3m6-3v3M1 9h3m-3 6h3m16-6h3m-3 6h3"/>
			case "strategy":
				<path d="M4 20V10m6 10V4m6 16v-7m4 7H2"/><path d="m4 7 5-4 6 7 5-5"/>
			case "evidence":
				<path d="M12 3 3.5 6v5.5c0 4.8 3.5 8.1 8.5 9.5 5-1.4 8.5-4.7 8.5-9.5V6L12 3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/>
			case "audit":
				<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h6m-6 4h6"/>
			case "search":
				<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/>
			case "plus":
				<path d="M12 5v14M5 12h14"/>
			case "arrow":
				<path d="M5 12h14m-5-5 5 5-5 5"/>
			case "back":
				<path d="M19 12H5m5-5-5 5 5 5"/>
			case "check":
				<path d="m5 12 4 4L19 6"/>
			case "close":
				<path d="m6 6 12 12M18 6 6 18"/>
			case "spark":
				<path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3Z"/><path d="m19 16 .8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z"/>
			case "upload":
				<path d="M12 16V4m-4 4 4-4 4 4M5 14v5h14v-5"/>
			case "edit":
				<path d="m14 5 5 5M4 20l3.5-.7L20 6.8 17.2 4 4.7 16.5 4 20Z"/>
			case "external":
				<path d="M14 4h6v6m0-6-9 9"/><path d="M18 13v6H5V6h6"/>
			case "logout":
				<path d="M10 5H5v14h5m4-4 4-3-4-3m4 3H9"/>
			case "user":
				<circle cx="12" cy="8" r="3.5"/><path d="M5 21a7 7 0 0 1 14 0"/>
			case "lock":
				<rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/>
			case "database":
				<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7"/>
			case "clock":
				<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
			case "chevron":
				<path d="m8 10 4 4 4-4"/>
			case "info":
				<circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-9v.01"/>
			case "trash":
				<path d="M4 7h16M9 7V4h6v3m3 0-1 14H7L6 7m4 4v6m4-6v6"/>
			default:
				<circle cx="12" cy="12" r="9"/>
		}
	</svg>
}

templ logo(inverse bool) {
	<div class="flex items-center gap-3">
		<span class={ logoMarkClass(inverse) }>
			<svg class="size-6" viewBox="0 0 32 32" fill="none" aria-hidden="true">
				<path d="M8 22c-5-7 1-17 10-15 8 1.7 9 12 2 15-5 2-9-3-6-7 2-3 7-1 6 2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
				<circle cx="24.5" cy="7.5" r="2.5" fill="currentColor" opacity=".55"/>
			</svg>
		</span>
		<span class="leading-none">
			<span class={ logoTextClass(inverse) }>Mnevo</span>
			<span class={ logoSubtextClass(inverse) }>忆循 · MEMORY OS</span>
		</span>
	</div>
}

func logoMarkClass(inverse bool) string {
	if inverse { return "grid size-11 place-items-center rounded-2xl bg-white/10 text-violet-300 ring-1 ring-white/10" }
	return "grid size-11 place-items-center rounded-2xl bg-brand text-white shadow-lg shadow-brand/20"
}

func logoTextClass(inverse bool) string {
	if inverse { return "block text-xl font-bold tracking-[-0.04em] text-white" }
	return "block text-xl font-bold tracking-[-0.04em] text-ink"
}

func logoSubtextClass(inverse bool) string {
	if inverse { return "mt-1.5 block text-[9px] font-medium tracking-[0.18em] text-slate-400" }
	return "mt-1.5 block text-[9px] font-medium tracking-[0.18em] text-slate-400"
}

templ spinner() {
	<span class="htmx-indicator size-4 animate-spin rounded-full border-2 border-current border-r-transparent" aria-hidden="true"></span>
}

templ pageHeader(p pageData, title string, description string) {
	<header class="mb-7 flex flex-col gap-4 sm:mb-9 sm:flex-row sm:items-end sm:justify-between">
		<div class="min-w-0">
			if p.ID != "" && p.View == "memory" {
				<a href={ memoryListURL(p) } class="mb-4 inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-brand">
					@icon("back", "size-4") 返回记忆库
				</a>
			}
			<div class="mb-2 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand">
				<span class="h-px w-5 bg-brand/60"></span>{ viewEyebrow(p.View) }
			</div>
			<h1 class="text-[1.8rem] font-semibold tracking-[-0.045em] text-ink sm:text-4xl">{ title }</h1>
			<p class="mt-2.5 max-w-2xl text-sm leading-6 text-slate-500 sm:text-[15px]">{ description }</p>
		</div>
		if p.View == "strategy" && p.Result.Policy != nil {
			<div class="flex shrink-0 items-center gap-3 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 shadow-xs">
				<span class="grid size-9 place-items-center rounded-xl bg-violet-50 text-brand">@icon("strategy", "size-4")</span>
				<div><span class="block text-[11px] text-slate-400">当前策略</span><strong class="text-sm text-slate-800">版本 v{ fmt.Sprint(p.Result.Policy.Version) }</strong></div>
			</div>
		}
	</header>
}

templ statusMessage(message string) {
	if message != "" {
		<div class={ messageClass(message) } role="status">
			<span class={ messageIconClass(message) }>
				if isErrorMessage(message) {
					@icon("info", "size-4")
				} else {
					@icon("check", "size-4")
				}
			</span>
			<div class="min-w-0 flex-1"><p class="text-sm font-medium">{ message }</p></div>
		</div>
	}
}

func isErrorMessage(message string) bool {
	return strings.HasPrefix(message, "操作失败") || strings.HasPrefix(message, "错误") || strings.HasPrefix(message, "error")
}

func messageClass(message string) string {
	if isErrorMessage(message) { return "mb-6 flex items-start gap-3 rounded-2xl border border-rose-100 bg-rose-50 px-4 py-3.5 text-rose-800" }
	return "mb-6 flex items-start gap-3 rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3.5 text-emerald-800"
}

func messageIconClass(message string) string {
	if isErrorMessage(message) { return "mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-rose-100" }
	return "mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-emerald-100"
}

templ emptyState(title string, description string) {
	<div class="flex flex-col items-center px-6 py-16 text-center sm:py-20">
		<span class="mb-5 grid size-14 place-items-center rounded-2xl bg-slate-100 text-slate-400">@icon("database", "size-6")</span>
		<h3 class="text-base font-semibold text-slate-800">{ title }</h3>
		<p class="mt-2 max-w-sm text-sm leading-6 text-slate-500">{ description }</p>
	</div>
}

templ kindBadge(kind string) {
	<span class={ kindClass(kind) }><span class="size-1.5 rounded-full bg-current"></span>{ kindLabel(kind) }</span>
}

func kindClass(kind string) string {
	switch kind {
	case "fact": return "chip bg-sky-50 text-sky-700"
	case "guideline": return "chip bg-violet-50 text-violet-700"
	case "procedure": return "chip bg-emerald-50 text-emerald-700"
	case "preference": return "chip bg-amber-50 text-amber-700"
	case "episode": return "chip bg-rose-50 text-rose-700"
	default: return "chip bg-slate-100 text-slate-600"
	}
}

templ readyBadge(ready bool, readyText string, notReadyText string) {
	if ready {
		<span class="chip bg-emerald-50 text-emerald-700"><span class="size-1.5 rounded-full bg-emerald-500"></span>{ readyText }</span>
	} else {
		<span class="chip bg-amber-50 text-amber-700"><span class="size-1.5 rounded-full bg-amber-500"></span>{ notReadyText }</span>
	}
}

templ csrfField(value string) {
	<input type="hidden" name="csrf" value={ value }/>
}

templ operationFields(p pageData, operation string) {
	@csrfField(p.CSRF)
	<input type="hidden" name="operation" value={ operation }/>
}

templ submitButton(label string, primary bool) {
	if primary {
		<button type="submit" class="btn-primary">@spinner() <span>{ label }</span></button>
	} else {
		<button type="submit" class="btn-secondary">@spinner() <span>{ label }</span></button>
	}
}
