package web

import (
	"fmt"
	"github.com/coxlong/mnevo/internal/domain"
)

templ strategyPage(p pageData) {
	<div class="space-y-8">
		<section aria-labelledby="proposals-heading">
			@sectionHeading("proposals-heading", "元学习诊断提案", "由可信证据触发，经 LLM 分析后等待人工决策")
			<div class="space-y-4">
				for _, proposal := range p.Result.Proposals {
					@proposalCard(p, proposal)
				}
				if len(p.Result.Proposals) == 0 {
					<div class="panel flex items-center gap-4 px-5 py-5"><span class="grid size-10 place-items-center rounded-xl bg-emerald-50 text-emerald-600">@icon("check", "size-5")</span><div><h3 class="text-sm font-semibold text-slate-700">暂无待审阅提案</h3><p class="mt-1 text-xs text-slate-400">系统积累足够的可信诊断证据后，会在这里生成改进建议。</p></div></div>
				}
			</div>
		</section>
		<section aria-labelledby="settings-heading">
			@sectionHeading("settings-heading", "数值策略与元学习参数", "所有修改都会发布新的策略版本，并保留完整历史")
			<div class="grid items-start gap-5 xl:grid-cols-[minmax(0,1.4fr)_minmax(320px,0.6fr)]">
				<div class="panel overflow-x-auto scrollbar-subtle">
					<table class="w-full min-w-[620px] border-collapse text-left text-xs">
						<thead><tr class="border-b border-slate-100 bg-slate-50/70 text-[11px] text-slate-400"><th class="px-5 py-3.5 font-medium">参数键</th><th class="px-4 py-3.5 font-medium">当前值</th><th class="px-4 py-3.5 font-medium">允许边界</th><th class="px-4 py-3.5 font-medium">元学习</th><th class="px-5 py-3.5 font-medium">生效方式</th></tr></thead>
						<tbody class="divide-y divide-slate-100">
							for _, row := range p.SettingRows {
								<tr class="transition hover:bg-slate-50/60"><td class="px-5 py-4 font-mono text-[11px] font-medium text-slate-700">{ row.Key }</td><td class="px-4 py-4 font-mono font-semibold text-brand">{ fmt.Sprint(row.Item.Value) }</td><td class="px-4 py-4 font-mono text-slate-500">[{ fmt.Sprint(row.Item.Bounds[0]) }, { fmt.Sprint(row.Item.Bounds[1]) }]</td><td class="px-4 py-4">@learnBadge(row.Item.Learn)</td><td class="px-5 py-4"><span class="chip bg-slate-100 text-slate-600">{ row.Item.Apply }</span></td></tr>
							}
						</tbody>
					</table>
				</div>
				<form method="post" action={ p.Action } hx-post={ p.Action } hx-target="#page-content" hx-disabled-elt="button" class="panel p-5 sm:p-6">
					@operationFields(p, "strategy")<input type="hidden" name="action" value="set"/>
					<div class="mb-5 flex items-center gap-3"><span class="grid size-9 place-items-center rounded-xl bg-violet-50 text-brand">@icon("edit", "size-4")</span><div><h3 class="text-sm font-semibold text-slate-800">修改数值参数</h3><p class="mt-0.5 text-[11px] text-slate-400">发布后立即可审计、可回滚</p></div></div>
					<div class="space-y-4">
						<label class="field-label">参数键
							<select class="field font-mono text-xs" name="target">
								for _, row := range p.SettingRows {
									<option value={ row.Key }>{ row.Key }</option>
								}
							</select>
						</label>
						<label class="field-label">当前值<input class="field font-mono" name="value" type="number" step="any" required/></label>
						<div class="grid grid-cols-2 gap-3"><label class="field-label">下限<input class="field font-mono" name="min" type="number" step="any" required/></label><label class="field-label">上限<input class="field font-mono" name="max" type="number" step="any" required/></label></div>
						<label class="field-label">生效方式<select class="field" name="apply"><option value="approval">approval · 审批后生效</option><option value="auto">auto · 自动生效</option></select></label>
						<label class="flex items-center gap-2 text-xs text-slate-500"><input name="learn" type="checkbox" class="size-4 accent-brand"/>允许元学习调整此参数</label>
						<button class="btn-primary w-full">@spinner() 发布策略变更</button>
					</div>
				</form>
			</div>
		</section>
		<section aria-labelledby="prompts-heading">
			@sectionHeading("prompts-heading", "可进化 Prompt 模板", "System 1 与 System 2 的核心提示词，修改仍需明确发布")
			<div class="grid items-start gap-5 xl:grid-cols-[minmax(0,1.4fr)_minmax(320px,0.6fr)]">
				<div class="space-y-3">
					for _, row := range p.PromptRows {
						<details class="group panel overflow-hidden">
							<summary class="flex cursor-pointer items-center gap-3 px-5 py-4"><span class="grid size-8 place-items-center rounded-lg bg-slate-100 text-slate-500">@icon("edit", "size-3.5")</span><code class="min-w-0 flex-1 truncate font-mono text-xs font-semibold text-slate-700">{ row.Key }</code>@learnBadge(row.Item.Learn)@icon("chevron", "size-4 text-slate-400 transition group-open:rotate-180")</summary>
							<pre class="whitespace-pre-wrap border-t border-slate-100 bg-slate-50/50 px-5 py-4 font-mono text-xs leading-6 text-slate-600">{ row.Item.Value }</pre>
						</details>
					}
				</div>
				<form method="post" action={ p.Action } hx-post={ p.Action } hx-target="#page-content" hx-disabled-elt="button" class="panel p-5 sm:p-6">
					@operationFields(p, "strategy")<input type="hidden" name="action" value="set-prompt"/>
					<h3 class="text-sm font-semibold text-slate-800">编辑 Prompt 模板</h3><p class="mt-1 text-[11px] text-slate-400">完整输入新内容，发布后替换当前模板</p>
					<div class="mt-5 space-y-4">
						<label class="field-label">Prompt 键
							<select class="field font-mono text-xs" name="target">
								for _, row := range p.PromptRows {
									<option value={ row.Key }>{ row.Key }</option>
								}
							</select>
						</label>
						<label class="field-label">Prompt 内容<textarea class="field min-h-52 resize-y font-mono text-xs leading-5" name="prompt_value" required></textarea></label>
						<label class="flex items-start gap-2 text-xs leading-5 text-slate-500"><input name="learn" type="checkbox" class="mt-0.5 size-4 shrink-0 accent-brand"/>允许元学习提出修改提案（仍需人工审批）</label>
						<button class="btn-primary w-full">@spinner() 发布 Prompt</button>
					</div>
				</form>
			</div>
		</section>
		if len(p.History) > 0 {
			<section aria-labelledby="history-heading">
				@sectionHeading("history-heading", "策略版本历史", "回滚会生成一个新版本，不会改写历史快照")
				<div class="panel overflow-x-auto scrollbar-subtle">
					<table class="w-full min-w-[640px] border-collapse text-left text-xs"><thead><tr class="border-b border-slate-100 bg-slate-50/70 text-slate-400"><th class="px-5 py-3.5 font-medium">版本</th><th class="px-4 py-3.5 font-medium">操作者</th><th class="px-4 py-3.5 font-medium">原因</th><th class="px-4 py-3.5 font-medium">时间</th><th class="px-5 py-3.5 text-right font-medium">操作</th></tr></thead><tbody class="divide-y divide-slate-100">
						for _, revision := range p.History {
							<tr><td class="px-5 py-4"><span class="chip bg-violet-50 font-mono text-brand">v{ fmt.Sprint(revision.Version) }</span></td><td class="px-4 py-4 text-slate-600">{ revision.Actor }</td><td class="px-4 py-4 text-slate-500">{ revision.Reason }</td><td class="whitespace-nowrap px-4 py-4 text-slate-400">{ formatTime(revision.UpdatedAt) }</td><td class="px-5 py-3 text-right"><form method="post" action={ p.Action } hx-post={ p.Action } hx-target="#page-content"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="operation" value="strategy"/><input type="hidden" name="target" value={ fmt.Sprint(revision.Version) }/><button class="btn-secondary min-h-8 px-3 py-1 text-xs" name="action" value="rollback" hx-confirm="确定回滚到此策略版本？">@spinner() 回滚到此版本</button></form></td></tr>
						}
					</tbody></table>
				</div>
			</section>
		}
		<details class="group panel overflow-hidden"><summary class="flex cursor-pointer items-center gap-3 px-5 py-4 text-sm font-medium text-slate-600">@icon("audit", "size-4 text-slate-400")<span class="flex-1">完整 strategy.json 快照</span>@icon("chevron", "size-4 text-slate-400 transition group-open:rotate-180")</summary><pre class="max-h-[540px] overflow-auto whitespace-pre-wrap border-t border-slate-100 bg-[#111224] p-5 font-mono text-xs leading-6 text-slate-300 scrollbar-subtle">{ p.SettingsJSON }</pre></details>
	</div>
}

templ sectionHeading(id string, title string, description string) {
	<div class="mb-4"><h2 id={ id } class="text-base font-semibold tracking-[-0.02em] text-slate-800">{ title }</h2><p class="mt-1 text-xs text-slate-400">{ description }</p></div>
}

templ learnBadge(learn bool) {
	if learn {
		<span class="chip bg-emerald-50 text-emerald-700">允许学习</span>
	} else {
		<span class="chip bg-slate-100 text-slate-500">已锁定</span>
	}
}

templ proposalCard(p pageData, proposal domain.Proposal) {
	<article class="panel overflow-hidden">
		<div class="h-1 bg-gradient-to-r from-brand via-violet-400 to-indigo-300"></div>
		<div class="p-5 sm:p-6">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-violet-50 text-brand">@icon("spark", "size-[18px]")</span><div><div class="flex flex-wrap items-center gap-2"><h3 class="text-sm font-semibold text-slate-800">{ proposal.Kind }</h3>@proposalStatus(proposal.Status)</div><code class="mt-1.5 block font-mono text-[11px] text-slate-400">{ proposal.TargetType }:{ proposal.TargetKey } · 基准 v{ fmt.Sprint(proposal.Base) }</code></div></div>
				if proposal.Published > 0 {
					<span class="text-xs text-slate-400">已发布为 v{ fmt.Sprint(proposal.Published) }</span>
				}
			</div>
			<div class="mt-5 rounded-xl bg-slate-50 p-4">
				if proposal.TargetType == "setting" {
					<p class="text-sm text-slate-600">参数建议 <strong class="mx-2 font-mono text-brand">{ fmt.Sprint(proposal.BeforeVal) } → { fmt.Sprint(proposal.AfterVal) }</strong></p>
				} else if proposal.TargetType == "prompt" {
					<div class="grid gap-3 md:grid-cols-2"><pre class="whitespace-pre-wrap font-mono text-[11px] leading-5 text-slate-500">修改前：{ proposal.BeforeText }</pre><pre class="whitespace-pre-wrap font-mono text-[11px] leading-5 text-slate-600">修改后：{ proposal.AfterText }</pre></div>
				} else {
					<p class="text-sm text-slate-600">记忆改进建议</p>
				}
			</div>
			<div class="mt-5"><h4 class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">LLM 根因分析</h4><p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-600">{ proposal.Diagnosis }</p></div>
			<div class="mt-4 grid gap-2 text-xs text-slate-500 sm:grid-cols-2"><p><span class="text-slate-400">预期影响：</span>{ proposal.Impact }</p><p><span class="text-slate-400">潜在风险：</span>{ proposal.Risk }</p></div>
			<div class="mt-5 flex flex-col gap-4 border-t border-slate-100 pt-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="flex flex-wrap gap-x-4 gap-y-1 text-[10px] text-slate-400"><span>提案 <code>{ proposal.ID }</code></span><a href="?view=evidence" class="text-brand hover:underline">查看关联证据 →</a></div>
				if proposal.Status == "pending" {
					<form method="post" action={ p.Action } hx-post={ p.Action } hx-target="#page-content" class="flex gap-2">
						@operationFields(p, "strategy")
						<input type="hidden" name="target" value={ proposal.ID }/>
						<button class="btn-primary" name="action" value="approve">@spinner() @icon("check", "size-4") 批准并发布</button>
						<button class="btn-danger" name="action" value="reject">@spinner() 拒绝</button>
					</form>
				}
			</div>
		</div>
	</article>
}

templ proposalStatus(status string) {
	if status == "pending" {
		<span class="chip bg-amber-50 text-amber-700">待审阅</span>
	} else if status == "approved" {
		<span class="chip bg-emerald-50 text-emerald-700">已批准</span>
	} else {
		<span class="chip bg-slate-100 text-slate-500">{ status }</span>
	}
}
