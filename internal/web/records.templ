package web

import (
	"fmt"
	"github.com/coxlong/mnevo/internal/domain"
)

templ evidencePage(p pageData) {
	<div class="space-y-6">
		<section class="panel overflow-hidden">
			<div class="flex items-start gap-4 border-b border-slate-100 px-5 py-5 sm:px-6"><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-amber-50 text-amber-600">@icon("evidence", "size-5")</span><div><h2 class="text-sm font-semibold text-slate-800">提交管理员核实诊断</h2><p class="mt-1 text-xs leading-5 text-slate-400">请关联具体任务并描述可验证的问题。诊断达到阈值后才会进入元学习分析。</p></div></div>
			<form method="post" action={ p.Action } hx-post={ p.Action } hx-target="#page-content" hx-disabled-elt="button" class="grid items-end gap-4 p-5 sm:p-6 lg:grid-cols-[1fr_1fr_1.5fr_auto]">
				@operationFields(p, "strategy")<input type="hidden" name="action" value="observe"/>
				<label class="field-label">问题类型<select class="field" name="kind"><option value="false_injection">false_injection · 误注入</option><option value="miss">miss · 漏召回</option><option value="wrong_attribution">wrong_attribution · 错误归因</option><option value="bad_revision">bad_revision · 错误修订</option></select></label>
				<label class="field-label">任务 ID<input class="field font-mono text-xs" name="task" placeholder="关联的任务标识" required/></label>
				<label class="field-label">核实说明<input class="field" name="evidence" placeholder="描述问题及判断依据" required/></label>
				<button class="btn-primary">@spinner() 提交诊断</button>
			</form>
		</section>
		<section>
			<div class="mb-3 flex items-center justify-between px-1"><div><h2 class="text-sm font-semibold text-slate-700">证据列表</h2><p class="mt-1 text-[11px] text-slate-400">自动线索与人工核实记录</p></div><span class="chip bg-slate-200/60 font-mono text-slate-500">{ fmt.Sprint(len(p.Result.Observations)) }</span></div>
			<div class="panel hidden overflow-x-auto scrollbar-subtle md:block">
				<table class="w-full min-w-[840px] border-collapse text-left text-xs"><thead><tr class="border-b border-slate-100 bg-slate-50/70 text-slate-400"><th class="px-5 py-3.5 font-medium">提交时间</th><th class="px-4 py-3.5 font-medium">问题类型</th><th class="px-4 py-3.5 font-medium">策略基准</th><th class="px-4 py-3.5 font-medium">状态</th><th class="px-4 py-3.5 font-medium">任务与说明</th><th class="px-5 py-3.5 text-right font-medium">操作</th></tr></thead><tbody class="divide-y divide-slate-100">
					for _, observation := range p.Result.Observations {
						<tr class="align-top transition hover:bg-slate-50/60"><td class="whitespace-nowrap px-5 py-4 text-slate-400">{ formatTime(observation.CreatedAt) }</td><td class="px-4 py-4"><code class="font-mono text-[11px] font-medium text-slate-700">{ observation.Kind }</code></td><td class="px-4 py-4"><span class="chip bg-slate-100 font-mono text-slate-500">v{ fmt.Sprint(observation.Base) }</span></td><td class="px-4 py-4">@trustBadge(observation.Trusted)</td><td class="max-w-md px-4 py-4"><code class="font-mono text-[10px] text-brand">{ observation.Task }</code><p class="mt-1.5 leading-5 text-slate-600">{ observation.Evidence }</p></td><td class="px-5 py-4 text-right">@confirmEvidence(p, observation.ID, observation.Trusted)</td></tr>
					}
					if len(p.Result.Observations) == 0 {
						<tr><td colspan="6">@emptyState("暂无诊断证据", "当召回或修订出现异常时，相关证据会显示在这里。")</td></tr>
					}
				</tbody></table>
			</div>
			<div class="space-y-3 md:hidden">
				for _, observation := range p.Result.Observations {
					<article class="panel p-4"><div class="flex items-center justify-between gap-3"><code class="font-mono text-[11px] font-medium text-slate-700">{ observation.Kind }</code>@trustBadge(observation.Trusted)</div><p class="mt-3 text-sm leading-6 text-slate-600">{ observation.Evidence }</p><div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[10px] text-slate-400"><span>{ formatTime(observation.CreatedAt) }</span><span>基准 v{ fmt.Sprint(observation.Base) }</span><code>{ observation.Task }</code></div><div class="mt-4 border-t border-slate-100 pt-3">@confirmEvidence(p, observation.ID, observation.Trusted)</div></article>
				}
				if len(p.Result.Observations) == 0 {
					<div class="panel">@emptyState("暂无诊断证据", "异常召回与修订的核实记录会显示在这里。")</div>
				}
			</div>
		</section>
	</div>
}

templ trustBadge(trusted bool) {
	if trusted {
		<span class="chip bg-emerald-50 text-emerald-700">@icon("check", "size-3") 已核实</span>
	} else {
		<span class="chip bg-amber-50 text-amber-700"><span class="size-1.5 rounded-full bg-amber-500"></span>待核实</span>
	}
}

templ confirmEvidence(p pageData, id string, trusted bool) {
	if !trusted {
		<form method="post" action={ p.Action } hx-post={ p.Action } hx-target="#page-content">@operationFields(p, "strategy")<input type="hidden" name="target" value={ id }/><button class="btn-secondary min-h-8 px-3 py-1.5 text-xs" name="action" value="confirm-evidence">@spinner() 确认为有效证据</button></form>
	} else { <span class="text-xs text-slate-300">—</span> }
}

templ auditPage(p pageData) {
	<div>
		<div class="mb-4 flex items-center justify-between px-1"><div class="flex items-center gap-2 text-xs text-slate-400">@icon("info", "size-3.5") 每页最多展示 250 条操作记录</div><span class="chip bg-slate-200/60 font-mono text-slate-500">{ fmt.Sprint(len(p.Result.Audit)) }</span></div>
		<div class="panel hidden overflow-x-auto scrollbar-subtle md:block">
			<table class="w-full min-w-[960px] border-collapse text-left text-xs"><thead><tr class="border-b border-slate-100 bg-slate-50/70 text-slate-400"><th class="px-5 py-3.5 font-medium">ID / 时间</th><th class="px-4 py-3.5 font-medium">操作</th><th class="px-4 py-3.5 font-medium">结果</th><th class="px-4 py-3.5 font-medium">策略版本</th><th class="px-4 py-3.5 font-medium">模型结果</th><th class="px-5 py-3.5 font-medium">详情</th></tr></thead><tbody class="divide-y divide-slate-100">
				for _, entry := range p.Result.Audit {
					<tr class="align-top transition hover:bg-slate-50/60">
						<td class="whitespace-nowrap px-5 py-4"><code class="font-mono text-[10px] text-slate-400">#{ fmt.Sprint(entry.ID) }</code><p class="mt-1 text-slate-500">{ formatTime(entry.At) }</p></td>
						<td class="px-4 py-4">
							<code class="font-mono text-[11px] font-medium text-slate-700">{ entry.Operation }</code>
							if entry.Trigger != "" {
								<p class="mt-1 text-[10px] text-slate-400">{ entry.Trigger }</p>
							}
						</td>
						<td class="px-4 py-4">
							<span class="chip bg-emerald-50 text-emerald-700">{ entry.Result }</span>
							if entry.Version > 0 {
								<span class="ml-1 font-mono text-[10px] text-slate-400">v{ fmt.Sprint(entry.Version) }</span>
							}
						</td>
						<td class="px-4 py-4 font-mono text-[11px] text-slate-500">{ entry.Strategy }</td>
						<td class="px-4 py-4">
							if entry.ModelOutcome != "" {
								<code class="font-mono text-[11px] text-slate-600">{ entry.ModelOutcome }</code><span class="ml-1 text-[10px] text-slate-400">{ fmt.Sprint(entry.ModelMS) }ms</span>
							} else {
								<span class="text-slate-300">—</span>
							}
						</td>
						<td class="max-w-sm px-5 py-4">@auditDetails(entry)</td>
					</tr>
				}
				if len(p.Result.Audit) == 0 {
					<tr><td colspan="6">@emptyState("暂无审计记录", "系统运行后的召回、配置和策略操作会记录在这里。")</td></tr>
				}
			</tbody></table>
		</div>
		<div class="space-y-3 md:hidden">
			for _, entry := range p.Result.Audit {
				<article class="panel p-4">
					<div class="flex items-center justify-between gap-3"><code class="font-mono text-xs font-semibold text-slate-700">{ entry.Operation }</code><span class="chip bg-emerald-50 text-emerald-700">{ entry.Result }</span></div>
					<div class="mt-3 grid grid-cols-2 gap-3 text-[11px]"><div><span class="block text-slate-400">时间</span><span class="mt-1 block text-slate-600">{ formatTime(entry.At) }</span></div><div><span class="block text-slate-400">策略</span><code class="mt-1 block text-slate-600">{ entry.Strategy }</code></div></div>
					if entry.ModelOutcome != "" {
						<p class="mt-3 text-xs text-slate-500">模型 <code>{ entry.ModelOutcome }</code> · { fmt.Sprint(entry.ModelMS) }ms</p>
					}
					<div class="mt-3 border-t border-slate-100 pt-3">@auditDetails(entry)</div>
				</article>
			}
			if len(p.Result.Audit) == 0 {
				<div class="panel">@emptyState("暂无审计记录", "系统操作与模型决策会记录在这里。")</div>
			}
		</div>
		if p.NextBefore > 0 {
			<a href={ auditNextURL(p.NextBefore) } hx-get={ auditNextURL(p.NextBefore) } hx-target="#page-content" hx-push-url="true" class="btn-secondary mt-5 w-full">查看更早记录 @icon("arrow", "size-4")</a>
		}
	</div>
}

templ auditDetails(entry domain.AuditEntry) {
	if entry.TaskID != "" || entry.Reference != "" || entry.MatchContext != "" || entry.Summary != "" {
		<details class="group">
			<summary class="flex cursor-pointer items-center gap-1.5 text-xs font-medium text-brand">查看详情@icon("chevron", "size-3 transition group-open:rotate-180")</summary>
			<div class="mt-3 space-y-2 rounded-xl bg-slate-50 p-3 text-[11px] leading-5 text-slate-500">
				if entry.TaskID != "" {
					<p>任务 <code class="font-mono text-slate-600">{ entry.TaskID }</code></p>
				}
				if entry.Reference != "" {
					<p>关联 <code class="break-all font-mono text-slate-600">{ entry.Reference }</code></p>
				}
				if entry.MatchContext != "" {
					<p class="whitespace-pre-wrap">{ entry.MatchContext }</p>
				}
				if entry.Summary != "" {
					<p class="whitespace-pre-wrap text-slate-600">{ entry.Summary }</p>
				}
			</div>
		</details>
	} else { <span class="text-slate-300">—</span> }
}
