package web

templ loginPage(base string, next string, csrf string, message string) {
	<!doctype html>
	<html lang="zh-CN" class="h-full antialiased">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#111224"/>
			<title>登录 · Mnevo 忆循</title>
			<link rel="stylesheet" href={ base + "assets/app.css" }/>
		</head>
		<body class="min-h-full bg-white">
			<main class="grid min-h-screen lg:grid-cols-[1.05fr_0.95fr]">
				<section class="relative hidden overflow-hidden bg-[#111224] p-12 text-white lg:flex lg:flex-col xl:p-16">
					<div class="absolute -left-32 top-1/3 size-96 rounded-full bg-violet-600/15 blur-3xl"></div>
					<div class="absolute -right-24 -top-24 size-80 rounded-full bg-indigo-500/10 blur-3xl"></div>
					<div class="relative">@logo(true)</div>
					<div class="relative my-auto max-w-xl py-20">
						<div class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.05] px-3 py-1.5 text-xs font-medium text-violet-200">
							@icon("spark", "size-3.5") 自适应长期记忆引擎
						</div>
						<h1 class="text-5xl font-semibold leading-[1.15] tracking-[-0.055em] xl:text-6xl">让每一次思考，<br/><span class="text-violet-300">都有迹可循。</span></h1>
						<p class="mt-7 max-w-md text-base leading-8 text-slate-400">沉淀知识，理解情境，持续进化。为你的 AI Agent 构建清晰、可信、可管理的长期记忆。</p>
						<div class="mt-12 grid max-w-lg grid-cols-3 gap-4">
							@loginFeature("01", "联想召回", "跨领域语义连接")
							@loginFeature("02", "记忆演化", "反馈驱动持续修订")
							@loginFeature("03", "受控进化", "每个决策有迹可查")
						</div>
					</div>
					<p class="relative text-xs tracking-wide text-slate-600">LOCAL-FIRST · PRIVATE BY DESIGN</p>
				</section>
				<section class="relative flex items-center justify-center bg-canvas px-5 py-10 sm:px-10 lg:bg-white">
					<div class="w-full max-w-[400px]">
						<div class="mb-10 lg:hidden">@logo(false)</div>
						<div class="mb-8">
							<p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand">Welcome back</p>
							<h2 class="text-3xl font-semibold tracking-[-0.04em] text-ink">登录管理台</h2>
							<p class="mt-3 text-sm leading-6 text-slate-500">使用本机管理员凭据继续。所有数据仅保存在你的设备上。</p>
						</div>
						if message != "" {
							<div class="mb-5 flex items-start gap-3 rounded-2xl border border-rose-100 bg-rose-50 px-4 py-3 text-sm text-rose-700" role="alert">@icon("info", "mt-0.5 size-4 shrink-0")<span>{ message }</span></div>
						}
						<form method="post" action={ base + "login" } class="space-y-5">
							@csrfField(csrf)
							<input type="hidden" name="next" value={ next }/>
							<label class="field-label">用户名
								<span class="relative mt-2 block">
									<span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-slate-400">@icon("user", "size-[18px]")</span>
									<input class="field mt-0 pl-11" name="username" value="mnevo" autocomplete="username" required/>
								</span>
							</label>
							<label class="field-label">管理密钥
								<span class="relative mt-2 block">
									<span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-slate-400">@icon("lock", "size-[18px]")</span>
									<input class="field mt-0 pl-11" type="password" name="password" autocomplete="current-password" placeholder="输入 admin.key 中的密钥" autofocus required/>
								</span>
							</label>
							<button type="submit" class="btn-primary mt-2 min-h-12 w-full">进入管理台 @icon("arrow", "size-4")</button>
						</form>
						<div class="mt-8 flex items-start gap-2.5 rounded-xl bg-slate-100/70 px-3.5 py-3 text-xs leading-5 text-slate-500">
							@icon("lock", "mt-0.5 size-3.5 shrink-0")
							<p>密钥位于 <code class="font-mono text-slate-700">~/.mnevo/admin.key</code>。会话将在 12 小时后自动过期。</p>
						</div>
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ loginFeature(number string, title string, description string) {
	<div class="border-l border-white/10 pl-4">
		<span class="font-mono text-[10px] text-violet-400">{ number }</span>
		<strong class="mt-2 block text-sm font-medium text-slate-200">{ title }</strong>
		<span class="mt-1 block text-[11px] leading-5 text-slate-500">{ description }</span>
	</div>
}
